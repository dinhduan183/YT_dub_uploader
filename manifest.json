{
  "manifest_version": 3,
  "name": "YT Dub Uploader",
  "version": "4.2",
  "description": "Trợ giúp thêm dub thủ công - chỉ mở dialog, bạn làm phần còn lại",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://studio.youtube.com/*"
  ],
  "icons": {
    "16": "new_icon_16.png",
    "32": "new_icon_32.png",
    "48": "new_icon_48.png",
    "128": "new_icon_128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Mở YT Dub Uploader",
    "default_icon": {
      "16": "new_icon_16.png",
      "32": "new_icon_32.png",
      "48": "new_icon_48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
